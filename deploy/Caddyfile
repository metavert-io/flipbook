# Caddyfile — Reverse proxy for flipbook SaaS mode
#
# Port 8080 is the external port (Fly.io health checks hit this).
# Flipbook backend runs on :8090, LastSaaS backend runs on :8091.
#
# Routing:
#   /api/flipbooks*, /api/saas/*, /api/public/* → Flipbook backend (:8090)
#   all other /api/*              → LastSaaS backend (:8091)
#   /health                       → LastSaaS backend (:8091)
#   Everything else               → Flipbook backend (:8090)
#
# NOTE: flipbook-owned API prefixes are the exception list; LastSaaS is the
# default for /api/* so newly added LastSaaS endpoints keep working without
# touching this file. If flipbook ever mounts new API prefixes (e.g.
# /api/public or /api/webhooks from internal/handlers), add them to the
# flipbook matcher below.

:8080 {
	# Flipbook-owned API routes
	@flipbookapi path_regexp ^/api/(flipbooks|saas|public)(/.*)?$
	handle @flipbookapi {
		request_body {
			max_size 500MB
		}
		reverse_proxy localhost:8090 {
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}

	# All other API routes belong to LastSaaS
	handle /api/* {
		reverse_proxy localhost:8091
	}
	handle /health {
		reverse_proxy localhost:8091
	}

	# Everything else goes to flipbook backend (viewer, embed, SPA, static)
	handle {
		request_body {
			max_size 500MB
		}
		reverse_proxy localhost:8090 {
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}
}
